{
  "name": "anytill",
  "version": "0.1.0",
  "private": true,
  "description": "Take crypto from any chain, get USDC on NEAR. A Shopify app plus a framework-free checkout widget, settled through NEAR Intents 1Click.",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "widget",
    "extensions/*"
  ],
  "scripts": {
    "setup": "prisma generate && prisma migrate deploy",
    "build:widget": "yarn workspace @anytill/widget build",
    "build": "yarn build:widget && react-router build",
    "dev": "yarn setup && yarn build:widget && react-router dev",
    "dev:shopify": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "demo": "yarn setup && yarn build && yarn start",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "yarn setup && yarn build && playwright test --project=e2e --project=mobile",
    "test:live-dry": "ANYTILL_LIVE_DRY=1 playwright test --project=unit -g \"live 1Click\"",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "deploy:shopify": "shopify app deploy",
    "config:link": "shopify app config link",
    "prisma": "prisma",
    "screenshots": "playwright test --project=screens"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^4.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "resolutions": {
    "qs": "^6.16.0"
  }
}
