# Anytill runs with NO keys in demo mode. Copy to .env only for a real store.

# SQLite file (relative to prisma/). Render mounts a disk at /var/data.
DATABASE_URL="file:./dev.sqlite"

# demo  = seeded demo store, simulated deposits, fake Shopify Admin (default)
# live  = real Shopify store, real 1Click deposit addresses, real settlement checks
ANYTILL_MODE=demo

# Where demo quotes come from: "dry" = live 1Click API with dry:true (real prices, no deposit address)
#                              "recorded" = fixtures in app/lib/fixtures (fully offline, deterministic)
ONECLICK_SOURCE=dry

# Optional 1Click partner JWT (https://partners.near-intents.org). Without it 1Click adds a 0.2% fee.
ONECLICK_JWT=
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# NEAR RPC used to verify the USDC transfer to the merchant on chain.
NEAR_RPC_URL=https://rpc.mainnet.near.org

# Shopify app credentials (Partner Dashboard → your app → Client credentials). Live mode only.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_orders,write_orders

# Optional: anchor each verified receipt's SHA-256 on NEAR (contract/). Off when ANCHOR_CONTRACT is empty.
ANCHOR_CONTRACT=
ANCHOR_SIGNER=
ANCHOR_NETWORK=testnet
# Key: a NEAR CLI key file (default ~/.near-credentials/<network>/<signer>.json) or, on a host, the secret itself.
ANCHOR_KEY_FILE=
ANCHOR_PRIVATE_KEY=
